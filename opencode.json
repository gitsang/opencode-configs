{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "shfmt": {
      "disabled": true
    }
  },
  "providers": {
    "saigw-anthropic": {
      "name": "Saigw (Anthropic)",
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "https://aigw.cn.c8g.top/anthropic/v1"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    },
    "saigw-openai": {
      "name": "Saigw (OpenAI)",
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://aigw.cn.c8g.top/v1"
      },
      "compatibility": {
        "supportsPromptCacheKey": true
      },
      "models": {
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini",
          "settings": {
            "store": false,
            "serviceTier": "priority",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          },
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            }
          ]
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "settings": {
            "store": false,
            "serviceTier": "priority",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          },
          "capabilities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
