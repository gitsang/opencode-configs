{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "shfmt": {
      "disabled": true
    }
  },
  "default_agent": "build",
  "providers": {
    "saigw-anthropic": {
      "name": "Saigw (Anthropic)",
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "https://aigw.cn.c8g.top/anthropic/v1"
      },
      "models": {
        "claude-opus": {
          "name": "Claude Opus",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    },
    "saigw-openai": {
      "name": "Saigw (OpenAI)",
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://aigw.cn.c8g.top/v1"
      },
      "compatibility": {
        "supportsPromptCacheKey": true
      },
      "models": {
        "gpt-astra": {
          "name": "GPT Astra",
          "settings": {
            "store": false,
            "serviceTier": "priority",
            "textVerbosity": "low",
            "reasoningSummary": "auto"
          },
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            }
          ]
        }
      }
    },
    "saigw-compatible": {
      "name": "S.AI (Compatible)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://aigw.cn.c8g.top/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "Deepseek Flash",
          "capabilities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  }
}

